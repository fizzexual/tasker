{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Fizz Task Manager",
  "version": "1.0.0",
  "identifier": "com.fizz.taskmanager",
  "mainBinaryName": "FizzTaskManager",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Fizz Task Manager",
        "width": 1000,
        "height": 660,
        "minWidth": 620,
        "minHeight": 380,
        "visible": false,
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Fizz",
    "shortDescription": "Lightweight task manager",
    "longDescription": "A lightweight task manager for Windows: processes, performance, startup apps and services.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "nsis": { "installMode": "currentUser" }
    }
  }
}
